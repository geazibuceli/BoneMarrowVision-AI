APP_ENVIRONMENT=development
DATABASE_URL=sqlite:///./bone_marrow_vision.db

# Generate independent values with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Docker Compose refuses to start until all three values below are filled.
POSTGRES_PASSWORD=
JWT_SECRET=
ADMIN_BOOTSTRAP_TOKEN=

UPLOAD_DIR=data/uploads
MODEL_DIR=models
CONFIG_DIR=ml/configs
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
MAX_CHECKPOINT_BYTES=2147483648
AUTH_RATE_LIMIT=30
AUTH_RATE_WINDOW_SECONDS=60
PREDICTION_RATE_LIMIT=30
PREDICTION_RATE_WINDOW_SECONDS=60
INFERENCE_QUEUE_SIZE=4
INFERENCE_QUEUE_TIMEOUT_SECONDS=30
# Optional email recovery. Use HTTPS for PASSWORD_RESET_URL in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_EXPIRE_MINUTES=30
GRADCAM_RETENTION_DAYS=30
INFERENCE_TEMP_RETENTION_HOURS=24
RETENTION_CLEANUP_INTERVAL_SECONDS=3600
TRUST_PROXY_HEADERS=false
CORS_ORIGINS=http://localhost:5173,http://localhost
